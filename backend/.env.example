PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/secure_file_storage

# At least 32 characters (256-bit entropy). Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars-0123456789

S3_ENDPOINT=http://localhost:9000
AWS_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=secure-files
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated content types allowed for upload (defense-in-depth allow-list)
ALLOWED_CONTENT_TYPES=application/octet-stream,application/json,application/pdf,application/zip,image/png,image/jpeg,text/plain,text/csv,audio/mpeg,video/mp4